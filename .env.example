# ============================================================
# Autonomous Research Agent - Environment Configuration
# ============================================================

# Gemini API Key (Required) - Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Gemini Model for Planning, Synthesis, and Verification
# Options: gemini-3.5-flash-lite, gemini-3.6-flash, gemini-flash-latest, gemini-2.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Fallback models in case of rate limits or temporary unavailability (comma-separated)
FALLBACK_MODELS=gemini-3.6-flash,gemini-flash-latest,gemini-2.5-flash

# Maximum research loop iterations before forcing report synthesis
MAX_RESEARCH_ITERATIONS=3

# Maximum search queries per iteration
MAX_SEARCH_QUERIES=4

# Maximum sources collected per search query
MAX_SOURCES_PER_QUERY=5

# Application Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# FastAPI Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
